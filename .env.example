PORT=5000
# local: mongodb://127.0.0.1:27017  |  Atlas: mongodb+srv://user:pass@cluster.../
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=jahid-capture
JWT_SECRET=at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=strong-password
# set on Vercel (auto-added when a Blob store is connected); unset = save to server/uploads/
BLOB_READ_WRITE_TOKEN=
